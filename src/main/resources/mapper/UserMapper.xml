<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaee.docai.user.mapper.UserMapper">

    <select id="selectByUsername" resultType="com.javaee.docai.user.entity.User">
        SELECT * FROM user WHERE username = #{username}
    </select>

    <select id="selectByEmail" resultType="com.javaee.docai.user.entity.User">
        SELECT * FROM user WHERE email = #{email}
    </select>

    <select id="selectByPhone" resultType="com.javaee.docai.user.entity.User">
        SELECT * FROM user WHERE phone = #{phone}
    </select>

    <select id="selectById" resultType="com.javaee.docai.user.entity.User">
        SELECT * FROM user WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.javaee.docai.user.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, email, phone, role, status, create_time, update_time)
        VALUES (#{username}, #{password}, #{email}, #{phone}, #{role}, #{status}, #{createTime}, #{updateTime})
    </insert>

    <update id="updateById" parameterType="com.javaee.docai.user.entity.User">
        UPDATE user
        SET username = #{username}, email = #{email}, phone = #{phone}, role = #{role},
            status = #{status}, update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM user WHERE id = #{id}
    </delete>

</mapper>
